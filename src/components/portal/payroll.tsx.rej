-        _staff_user_id: genForm.staff_user_id, _from: from, _to: to,
-      });
-      const workingLeaveDays = Number(lwd ?? 0);
-      if (l.leave_type === 'unpaid') unpaidLeave += workingLeaveDays; else paidLeave += workingLeaveDays;
+    for (const r of leaveResults) {
