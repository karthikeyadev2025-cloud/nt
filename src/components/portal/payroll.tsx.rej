     }
     const absent = Math.max(0, workingDaysInMonth - present - paidLeave - unpaidLeave);
 
+    // Late fine from the staff's currently-assigned shift. Before this,
+    // shift.late_fine_amount was configurable in ShiftsManager but the
+    // generator only used the manually-entered genForm.late_fine (default
+    // 0), so late-fine deductions never actually landed on autofilled
+    // payslips. Two supported fine types: 'per_day' (× late_days) and
+    // 'fixed' (flat amount if any late days). 'none' → 0.
+    const { data: shiftRow } = await supabase
+      .from('staff_shifts')
+      .select('shifts(late_fine_type, late_fine_amount)')
+      .eq('staff_user_id', genForm.staff_user_id)
+      .is('effective_to', null)
