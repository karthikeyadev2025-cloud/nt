+    // relational selects to Json until types are regenerated.
+    type ShiftFineJoin = { shifts: { late_fine_type: string | null; late_fine_amount: number | null } | null };
+    const shift = (shiftRow as ShiftFineJoin | null)?.shifts;
+    let lateFine = genForm.late_fine;
+    if (shift && lateDays > 0) {
+      if (shift.late_fine_type === 'per_day') {
+        lateFine = (shift.late_fine_amount || 0) * lateDays;
+      } else if (shift.late_fine_type === 'fixed') {
