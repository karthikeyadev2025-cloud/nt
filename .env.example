VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Turnstile — public site key for the ticket-raise form's bot
# check. Get one at https://dash.cloudflare.com/?to=/:account/turnstile.
# Leave blank in dev; the widget won't render and the form will fall back
# to a static error message on submit (fail-closed). The matching server
# secret goes into the `raise-ticket` edge function's env as
# TURNSTILE_SECRET_KEY (Supabase Dashboard → Edge Functions → Secrets).
VITE_TURNSTILE_SITE_KEY=
